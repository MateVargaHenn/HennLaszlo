# Install only after an IP-address certificate has been issued. This dedicated
# port leaves all existing HTTPS virtual hosts on 443 unchanged.
server {
    listen 18443 ssl;
    server_name 194.182.85.127;
    ssl_certificate /etc/letsencrypt/live/194.182.85.127/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/194.182.85.127/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

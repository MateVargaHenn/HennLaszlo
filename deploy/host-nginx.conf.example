# Install only after preview.hennlaszlo.hu resolves to this VPS and its TLS
# certificate exists. Keep the existing hennlaszlo.hu server block intact.
server {
    listen 80;
    server_name preview.hennlaszlo.hu;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name preview.hennlaszlo.hu;
    ssl_certificate /etc/letsencrypt/live/preview.hennlaszlo.hu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/preview.hennlaszlo.hu/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "public-web": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/public-web",
      "sourceRoot": "projects/public-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/public-web/src/main.ts",
            "tsConfig": "projects/public-web/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/public-web/public"
              }
            ],
            "styles": ["projects/public-web/src/styles.css"],
            "server": "projects/public-web/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/public-web/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/public-web/src/environments/environment.ts",
                  "with": "projects/public-web/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "public-web:build:production"
            },
            "development": {
              "buildTarget": "public-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "admin-web": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/admin-web",
      "sourceRoot": "projects/admin-web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin-web/src/main.ts",
            "tsConfig": "projects/admin-web/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin-web/public"
              }
            ],
            "styles": ["projects/admin-web/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/admin-web/src/environments/environment.ts",
                  "with": "projects/admin-web/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin-web:build:production"
            },
            "development": {
              "buildTarget": "admin-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "artwork-data-access": {
      "projectType": "library",
      "root": "projects/artwork-data-access",
      "sourceRoot": "projects/artwork-data-access/src",
      "prefix": "henn",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/artwork-data-access/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/artwork-data-access/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/artwork-data-access/tsconfig.spec.json"
          }
        }
      }
    },
    "invitation-data-access": {
      "projectType": "library",
      "root": "projects/invitation-data-access",
      "sourceRoot": "projects/invitation-data-access/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/invitation-data-access/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/invitation-data-access/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/invitation-data-access/tsconfig.spec.json"
          }
        }
      }
    }
  }
}

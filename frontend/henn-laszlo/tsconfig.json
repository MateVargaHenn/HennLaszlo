/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "artwork-data-access": ["./dist/artwork-data-access"],
      "content-data-access": ["./dist/content-data-access"],
      "invitation-data-access": ["./dist/invitation-data-access"],
      "video-data-access": ["./dist/video-data-access"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/public-web/tsconfig.app.json"
    },
    {
      "path": "./projects/public-web/tsconfig.spec.json"
    },
    {
      "path": "./projects/admin-web/tsconfig.app.json"
    },
    {
      "path": "./projects/admin-web/tsconfig.spec.json"
    },
    {
      "path": "./projects/artwork-data-access/tsconfig.lib.json"
    },
    {
      "path": "./projects/artwork-data-access/tsconfig.spec.json"
    },
    {
      "path": "./projects/invitation-data-access/tsconfig.lib.json"
    },
    {
      "path": "./projects/invitation-data-access/tsconfig.spec.json"
    },
    {
      "path": "./projects/content-data-access/tsconfig.lib.json"
    },
    {
      "path": "./projects/content-data-access/tsconfig.spec.json"
    },
    {
      "path": "./projects/video-data-access/tsconfig.lib.json"
    },
    {
      "path": "./projects/video-data-access/tsconfig.spec.json"
    }
  ]
}
